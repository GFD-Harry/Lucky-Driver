# Cổng server
PORT=3000

# Google OAuth Client ID (loại "Web application") – xem README
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Các email có quyền Owner, cách nhau bởi dấu phẩy
OWNER_EMAILS=tainguyen21204@gmail.com,duyngyn1204.04@gmail.com

# Chuỗi bí mật dài bất kỳ để ký cookie đăng nhập. Tạo bằng:
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# Thư mục lưu wheel.json + ảnh (mặc định ./data)
# DATA_DIR=./data

# Thời gian 1 lượt quay (ms)
# SPIN_MS=6000

# Bật nút "Dev login" để đăng nhập Owner không cần Google – CHỈ dùng khi chạy local
# DEV_LOGIN=1

# URL công khai của app (chỉ cần nếu chạy sau proxy và Google báo redirect_uri_mismatch)
# PUBLIC_URL=https://lucky-wheel.onrender.com
